@echo off
rem plan: 把这个文件复制到**仓库根目录**、改名为 tagger.env.cmd，填好后 start-tagger.cmd 会自动 call 它
rem
rem 独立服务不经过 DSH，所以拿不到宿主的 llm 服务，这里要直接给一个 OpenAI 兼容接口。
rem 不填也能启动：只是锻造 / 精修会回 no-llm，标签检索与 ComfyUI 投递照常。

rem 例：DeepSeek 官方
rem set "DSH_TAGGER_BASE_URL=https://api.deepseek.com"
rem set "DSH_TAGGER_API_KEY=sk-xxxxxxxx"
rem set "DSH_TAGGER_MODEL=deepseek-chat"

rem 例：本地 vLLM / one-api / new-api 网关
rem set "DSH_TAGGER_BASE_URL=http://127.0.0.1:8000/v1"
rem set "DSH_TAGGER_API_KEY=dummy"
rem set "DSH_TAGGER_MODEL=Qwen3.5-9B"

rem 可选：数据目录与工作流目录
rem set "DSH_TAGGER_DATA=%USERPROFILE%\.dsh-tagger"
rem set "DSH_TAGGER_WORKFLOW_DIR=C:\Users\<你的用户名>\.dsh-comfyui-workbench\workflows"
