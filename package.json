{
  "name": "dsh-tagger",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSh Tagger：白话 → WD + Camie 标签 → ComfyUI，带二次 AI 精修与扩展接口（桌面端优先）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./spi": "./lib/spi.js",
    "./server": "./server/standalone.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tagger": "./bin/tagger.mjs"
  },
  "files": [
    "index.js",
    "lib/",
    "server/",
    "data/",
    "locale/",
    "icon.svg",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node bin/tagger.mjs",
    "serve": "node bin/tagger.mjs",
    "test": "node scripts/dev/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:tags": "node scripts/tags/check-tags.mjs",
    "check:overlay": "node scripts/tags/check-overlay-tags.mjs",
    "check:layout": "node scripts/dev/check-layout.mjs",
    "bench": "node scripts/dev/bench.mjs",
    "check": "npm run check:tags && npm run check:overlay && npm run check:layout && npm run typecheck && npm test",
    "pack": "node scripts/release/pack.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "meta": {
    "title": "DSh Tagger",
    "description": "白话描述直接锻造成 WD + Camie 标签并投递 ComfyUI；锻造完还能让 AI 二次增删，扩展接口留给其他插件与 web 版。"
  }
}
