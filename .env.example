# plan: docker compose 用的环境变量模板——复制成 .env 再改
# 复制：cp .env.example .env（Windows：copy .env.example .env）

# 监听端口（宿主机侧；容器内固定 7789）
DSH_TAGGER_PORT=7789

# 模型接口（OpenAI 兼容）。留空就只做本地锻造链路，锻造会如实回 no-llm
DSH_TAGGER_BASE_URL=https://api.openai.com/v1
DSH_TAGGER_API_KEY=
DSH_TAGGER_MODEL=gpt-4o-mini

# ComfyUI 地址：ComfyUI 跑在宿主机上时用 host.docker.internal
DSH_TAGGER_COMFY_URL=http://host.docker.internal:8188

# 工作流模板目录（容器内路径；要在容器里用就挂卷，见 docker-compose.yml 注释）
DSH_TAGGER_WORKFLOW_DIR=